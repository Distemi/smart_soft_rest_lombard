{% extends 'base.html.twig' %}

{% block title %}Филиал "{{ workplace.displayTitle }}" - Админ-панель{% endblock %}

{% block navbar %}
{{ include('components/_admin_navbar.html.twig') }}
{% endblock %}

{% block body %}
<div class="container-fluid my-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_admin_workplaces') }}">Филиалы</a></li>
            <li class="breadcrumb-item active">{{ workplace.displayTitle }}</li>
        </ol>
    </nav>

    <h1 class="mb-4">Филиал: {{ workplace.displayTitle }}</h1>

    <div class="row g-4 align-items-start">
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Информация о филиале</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                        {% if workplace.isActive %}
                            <span class="badge bg-success">Активен</span>
                        {% else %}
                            <span class="badge bg-danger">Неактивен</span>
                        {% endif %}
                        <span class="text-muted small">ID {{ workplace.id }}</span>
                    </div>
                    <p class="fs-5 fw-semibold mb-3">{{ workplace.displayTitle }}</p>
                    <p><strong>Заголовок:</strong> {{ workplace.title ?? '-' }}</p>
                    <p><strong>Город:</strong> {{ workplace.city ?? '-' }}</p>
                    <p><strong>Адрес:</strong> {{ workplace.address ?? '-' }}</p>
                    <p><strong>Телефон:</strong> {{ workplace.phone ? workplace.phone|format_phone : '-' }}</p>
                    <p><strong>ОКАТО:</strong> {{ workplace.okato ?? '-' }}</p>
                    <p><strong>Создан:</strong> {{ workplace.createdAt|date('d.m.Y H:i') }}</p>
                    <p><strong>Обновлён:</strong> {{ workplace.updatedAt|date('d.m.Y H:i') }}</p>
                    <p><strong>Изображения филиала:</strong></p>
                    {% if workplace.imageLinks is not empty %}
                        <div class="d-flex flex-wrap gap-3">
                            {% if workplace.imageLinks.preview is defined and workplace.imageLinks.preview %}
                                <a href="{{ workplace.imageLinks.full_size ?? workplace.imageLinks.preview }}" target="_blank" rel="noopener noreferrer" class="d-inline-block">
                                    <img
                                        src="{{ workplace.imageLinks.preview }}"
                                        alt="Изображение филиала"
                                        loading="lazy"
                                        decoding="async"
                                        referrerpolicy="no-referrer"
                                        class="border rounded"
                                        style="max-width: 220px; max-height: 220px; object-fit: contain;"
                                    >
                                </a>
                            {% endif %}
                            {% if workplace.imageLinks.full_size is defined and workplace.imageLinks.full_size %}
                                <a href="{{ workplace.imageLinks.full_size }}" target="_blank" rel="noopener noreferrer">Открыть полноразмерное изображение</a>
                            {% endif %}
                        </div>
                    {% else %}
                        <p class="mb-0">-</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Клиенты ({{ uniqueClientsCount }})</h5>
                </div>
                <div class="card-body">
                    {% if workplaceClients|length > 0 %}
                        <div class="list-group">
                            {% for client in workplaceClients %}
                                <a href="{{ path('app_admin_client_view', {clientType: client.clientType, externalId: client.externalId}) }}" class="list-group-item list-group-item-action">
                                    <div class="fw-semibold">{{ client.fullName }}</div>
                                    <div class="text-muted small">
                                        ID {{ client.externalId }} · {{ client.clientTypeLabel }}
                                    </div>
                                </a>
                            {% endfor %}
                        </div>

                        {% if clientsPagination.pagesCount > 1 %}
                            <nav class="mt-3" aria-label="Пагинация клиентов филиала">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item {% if clientsPagination.page <= 1 %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('app_admin_workplace_view', {id: workplace.id, clientsPage: clientsPagination.page - 1, ticketsPage: ticketsPagination.page}) }}">Назад</a>
                                    </li>
                                    {% for page in 1..clientsPagination.pagesCount %}
                                        <li class="page-item {% if page == clientsPagination.page %}active{% endif %}">
                                            <a class="page-link" href="{{ path('app_admin_workplace_view', {id: workplace.id, clientsPage: page, ticketsPage: ticketsPagination.page}) }}">{{ page }}</a>
                                        </li>
                                    {% endfor %}
                                    <li class="page-item {% if clientsPagination.page >= clientsPagination.pagesCount %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('app_admin_workplace_view', {id: workplace.id, clientsPage: clientsPagination.page + 1, ticketsPage: ticketsPagination.page}) }}">Вперёд</a>
                                    </li>
                                </ul>
                            </nav>
                        {% endif %}
                    {% else %}
                        <div class="alert alert-info mb-0">Клиенты в этом филиале пока не найдены.</div>
                    {% endif %}
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">Билеты ({{ ticketsPagination.totalCount }})</h5>
                </div>
                <div class="card-body">
                    {% if workplaceTickets|length > 0 %}
                        <div class="list-group">
                            {% for ticket in workplaceTickets %}
                                <a href="{{ path('app_admin_ticket_view', {workplaceId: workplace.id, ticketNumber: ticket.ticketNumber}) }}" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
                                    <span>
                                        <span class="fw-semibold">{{ ticket.ticketNumber }}</span>
                                        <span class="text-muted small ms-2">
                                            {{ ticket.issueDate ? ticket.issueDate|date('d.m.Y') : '-' }}
                                        </span>
                                    </span>
                                    {% if ticket.isOpen %}
                                        <span class="badge bg-success">{{ ticket.statusLabel }}</span>
                                    {% else %}
                                        <span class="badge bg-secondary">{{ ticket.statusLabel }}</span>
                                    {% endif %}
                                </a>
                            {% endfor %}
                        </div>

                        {% if ticketsPagination.pagesCount > 1 %}
                            <nav class="mt-3" aria-label="Пагинация билетов филиала">
                                <ul class="pagination pagination-sm mb-0">
                                    <li class="page-item {% if ticketsPagination.page <= 1 %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('app_admin_workplace_view', {id: workplace.id, clientsPage: clientsPagination.page, ticketsPage: ticketsPagination.page - 1}) }}">Назад</a>
                                    </li>
                                    {% for page in 1..ticketsPagination.pagesCount %}
                                        <li class="page-item {% if page == ticketsPagination.page %}active{% endif %}">
                                            <a class="page-link" href="{{ path('app_admin_workplace_view', {id: workplace.id, clientsPage: clientsPagination.page, ticketsPage: page}) }}">{{ page }}</a>
                                        </li>
                                    {% endfor %}
                                    <li class="page-item {% if ticketsPagination.page >= ticketsPagination.pagesCount %}disabled{% endif %}">
                                        <a class="page-link" href="{{ path('app_admin_workplace_view', {id: workplace.id, clientsPage: clientsPagination.page, ticketsPage: ticketsPagination.page + 1}) }}">Вперёд</a>
                                    </li>
                                </ul>
                            </nav>
                        {% endif %}
                    {% else %}
                        <div class="alert alert-info mb-0">Билеты по этому филиалу пока отсутствуют.</div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <a href="{{ path('app_admin_workplaces') }}" class="btn btn-secondary">
        <i class="bi bi-arrow-left"></i> Назад к списку филиалов
    </a>
</div>
{% endblock %}
