{% extends 'base.html.twig' %}

{% block title %}Залоговый билет {{ ticket.ticketNumber }} - Личный кабинет{% endblock %}

{% block navbar %}
{{ include('components/_client_navbar.html.twig') }}
{% endblock %}

{% block body %}
<div class="container my-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="{{ path('app_tickets_list') }}">Мои билеты</a></li>
            <li class="breadcrumb-item active">{{ ticket.ticketNumber }}</li>
        </ol>
    </nav>

    {% set ticketCurrency = ticket.currencyCode ?? 'RUB' %}
    <div class="row">
        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">
                        Залоговый билет № {{ ticket.ticketNumber }}
                        {% if ticket.testOperation %}
                            <span class="badge bg-warning text-dark ms-2">Тестовая операция</span>
                        {% endif %}
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Дата выдачи:</strong></p>
                            <p>{{ ticket.issueDate ? ticket.issueDate|date('d.m.Y') : '-' }}</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Дата возврата:</strong></p>
                            <p>{{ ticket.dueDate ? ticket.dueDate|date('d.m.Y') : '-' }}</p>
                        </div>
                    </div>

                    {% if ticket.workplace %}
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <p class="mb-2"><strong>Филиал:</strong></p>
                            <p><span class="badge bg-info fs-6">{{ ticket.workplace.displayTitle }}</span></p>
                            {% if ticket.workplace.address %}
                                <p class="text-muted small mb-0"><i class="bi bi-geo-alt"></i> {{ ticket.workplace.address }}</p>
                            {% endif %}
                            {% if ticket.workplace.phone %}
                                <p class="text-muted small"><i class="bi bi-telephone"></i> {{ ticket.workplace.phone|format_phone }}</p>
                            {% endif %}
                        </div>
                    </div>
                    {% endif %}

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Сумма займа:</strong></p>
                            <p class="h5 text-primary">{{ ticket.loanAmount is not null ? ticket.loanAmount|number_format(2, '.', ' ') ~ ' ' ~ ticketCurrency : '-' }}</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Текущий долг:</strong></p>
                            <p class="h5 text-danger">{{ ticket.currentDebt is not null ? ticket.currentDebt|number_format(2, '.', ' ') ~ ' ' ~ ticketCurrency : '-' }}</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Оценочная стоимость:</strong></p>
                            <p>{{ ticket.pledgeAmount is not null ? ticket.pledgeAmount|number_format(2, '.', ' ') ~ ' ' ~ ticketCurrency : '-' }}</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Процентная ставка:</strong></p>
                            <p>{{ ticket.interestRate is not null ? ticket.interestRate ~ '%' : '-' }}</p>
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Срок займа:</strong></p>
                            <p>{{ ticket.duration is not null ? ticket.duration ~ ' дн.' : '-' }}</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-2"><strong>Уплаченные проценты:</strong></p>
                            <p>{{ ticket.paidPercents is not null ? ticket.paidPercents|number_format(2, '.', ' ') ~ ' ' ~ ticketCurrency : '-' }}</p>
                        </div>
                    </div>

                    {% if ticket.comment %}
                        <div class="row mb-3">
                            <div class="col-md-12">
                                <p class="mb-2"><strong>Комментарий:</strong></p>
                                <p>{{ ticket.comment }}</p>
                            </div>
                        </div>
                    {% endif %}

                    <div class="row">
                        <div class="col-md-12">
                            <p class="mb-2"><strong>Статус:</strong></p>
                            <p>
                                {% if ticket.isOpen %}
                                    <span class="badge bg-success fs-6">{{ ticket.statusLabel }}</span>
                                {% else %}
                                    <span class="badge bg-secondary fs-6">{{ ticket.statusLabel }}</span>
                                {% endif %}
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            {% if ticket.pawnGoods|length > 0 %}
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">Заложенное имущество</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Наименование</th>
                                    <th>Категория</th>
                                    <th>Оценочная стоимость</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for item in ticket.pawnGoods %}
                                {% set itemCurrency = item.currencyCode ?? ticketCurrency %}
                                <tr>
                                    <td>
                                        <strong>{{ item.name }}</strong>
                                        {% if item.description %}
                                            <br><small class="text-muted">{{ item.description }}</small>
                                        {% endif %}
                                        {% if item.serialNumber %}
                                            <br><small class="text-muted">Серийный номер: {{ item.serialNumber }}</small>
                                        {% endif %}
                                    </td>
                                    <td>{% if item.category %}{{ item.category.name }}{% else %}<span class="text-muted">-</span>{% endif %}</td>
                                    <td>{{ item.estimatedValue|number_format(2, '.', ' ') }} {{ itemCurrency }}</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
